# Caddyfile de producción para Multitec en Windows Server.
#
# Sirve el frontend compilado (frontend/dist) como archivos estáticos y hace proxy de
# /api y /uploads al backend FastAPI (uvicorn, corriendo como servicio de Windows en
# 127.0.0.1:8000 — ver install-backend-service.ps1).
#
# Por defecto usa "tls internal" (certificado autofirmado de Caddy, válido para una red
# local sin dominio público ni acceso a internet para ACME). Si el servidor tiene un
# dominio real y acceso a internet, cambia el bloque de sitio por el dominio
# (ej. "erp.multitec.com.do {") y Caddy obtiene HTTPS automático de Let's Encrypt sin
# configuración adicional.

multitec.local {
	tls internal

	# SPA: cualquier ruta que no sea archivo real cae en index.html (React Router)
	root * ../frontend/dist
	encode gzip

	# Cabeceras de seguridad. Mismo contenido que frontend/security-headers.ts (que cubre
	# `vite preview`): si cambias una, cámbiala en las dos. HSTS sin includeSubDomains ni preload
	# a propósito: con "tls internal" el certificado es propio y un error de certificado no debe
	# dejar a nadie bloqueado por un año.
	header {
		# "?" = solo si el backend no la puso: /uploads ya trae una CSP más estricta (sandbox).
		?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; frame-src https://www.openstreetmap.org https://maps.google.com https://www.google.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=2592000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), microphone=(self), camera=(self)"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /uploads/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
