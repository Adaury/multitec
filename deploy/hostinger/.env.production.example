# =====================================================================================================
#  MULTITEC — configuración de PRODUCCIÓN (Hostinger)
#  Copia este archivo como  .env  dentro de la carpeta de la aplicación (NO dentro de public_html) y rellena los
#  valores. El archivo .env contiene secretos: nunca lo subas a un repositorio ni lo mandes por correo.
# =====================================================================================================

APP_NAME=Multitec
APP_ENV=production
# Debe ser false en producción: con true, un error mostraría rutas, consultas y claves.
APP_DEBUG=false
# La dirección pública, con https. Ejemplo: https://app.tudominio.com
APP_URL=https://CAMBIA-ESTO.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# --- Claves (OBLIGATORIAS y DISTINTAS entre sí) ---
# APP_KEY:  genera con  php artisan key:generate --show   (o 32 bytes aleatorios en base64 con prefijo base64:)
# JWT_SECRET: 64 caracteres aleatorios (firma las sesiones). Si lo cambias, todos tendrán que volver a iniciar sesión.
APP_KEY=
JWT_SECRET=

# --- Base de datos MySQL (créala en hPanel → Bases de datos) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uXXXXXXXX_multitec
DB_USERNAME=uXXXXXXXX_multitec
DB_PASSWORD=

# --- Registro y sesiones (no hace falta tocarlo) ---
LOG_CHANNEL=single
LOG_LEVEL=warning
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Tiempo de las sesiones ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# --- Fiscal (República Dominicana) ---
ITBIS_RATE=0.18
QUOTE_STALE_DAYS=7
INVOICE_DUE_DAYS=7

# --- Multitec como servicio ---
PUBLIC_SIGNUP_ENABLED=true
PLATFORM_TRIAL_DAYS=45
PLATFORM_CURRENCY=USD
PLATFORM_SETUP_FEE=160
PLATFORM_MONTHLY_FEE=40
# Cuentas para que las empresas te paguen (una por línea, separadas con \n). Vacío = las de «Mi empresa».
PLATFORM_PAYMENT_INFO=
PLATFORM_CONTACT_PHONE=829-283-1336,829-477-8613
# Duración de las sesiones de soporte (minutos)
SUPPORT_SESSION_MINUTES=60

# --- Avisos por correo (opcional: sin esto la campanita funciona igual) ---
# Correo de Hostinger: hPanel → Correos → crea una cuenta y usa sus datos.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Multitec"
# A dónde llegan los avisos de nuevas empresas (vacío = a cada administrador)
# IA (opcional). Sin clave todo funciona a mano. Con clave, los datos de clientes que vayan en una consulta salen hacia Google.
GEMINI_API_KEY=
NOTIFICATION_EMAIL=

# --- Mapa del proyecto: países donde se buscan direcciones (códigos ISO separados por coma) ---
GEO_COUNTRY_CODES=do

# --- Seguridad de red ---
# Proxies de confianza (para leer la IP real del visitante). VACÍO en Hostinger compartido.
# Si algún día pones Cloudflare delante, escribe aquí sus rangos de IP (no uses * salvo que sepas lo que haces).
TRUSTED_PROXIES=
# Otros sitios que puedan llamar a la API desde un navegador (vacío = ninguno; la app y la API están en el mismo dominio)
CORS_ALLOWED_ORIGINS=
